# =============================================================================
# WIFI QUEST - Variables de entorno para Docker Compose / Dokploy
#
# Copiá este archivo a `.env` (en la raíz del repo) y completá los valores.
# En Dokploy podés cargar las mismas variables desde la pestaña "Environment"
# (Dokploy escribe ese .env por vos).
#
# NO subas `.env` al repositorio: está en .gitignore.
# =============================================================================

# ---- Dominios ----
# Origen permitido para CORS en el backend (el frontend)
ALLOWED_ORIGIN=https://k.alexa.tja.ucb.edu.bo
# URL pública del backend que el frontend usa para /api
VITE_API_URL=https://k2.alexa.tja.ucb.edu.bo

# ---- Contraseña WiFi (OBLIGATORIA para /api/verify) ----
# Debe ser la misma que usa el juego. Se deja vacía a propósito: sin secretos acá.
WIFI_PASS=

# ---- Motor del Nivel 1 ----
LEVEL1_ENGINE=v2
REVEAL_WORD_TO_MODEL=true

# ---- Proveedores de IA (opcionales) ----
# Si una key queda vacía, ese proveedor se salta automáticamente (round-robin).
GROQ_API_KEY=
GROQ_MODEL=

CF_ACCOUNT_ID=
CF_API_KEY=
CF_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=
