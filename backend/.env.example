PORT=3000
ALLOWED_ORIGIN=*

# API Keys (los 3 proveedores entran en el round-robin; si falta una key se salta)
GROQ_API_KEY=tu_groq_api_key_aqui
CF_ACCOUNT_ID=tu_cloudflare_account_id_aqui
CF_API_KEY=tu_cloudflare_api_key_aqui
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Modelos de IA por defecto
GROQ_MODEL=llama-3.1-8b-instant
CF_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
GEMINI_MODEL=gemini-3.1-flash-lite

# Contraseña WiFi única (Nivel 1 y Nivel 2). Debe coincidir en todos los alias.
WIFI_PASS=OrnitorrincoLunar7$

# Motor del Nivel 1: v1 (legado) | v2 (nuevo) | shadow (loguea v2, responde v1)
LEVEL1_ENGINE=v2
# Modo A/B para la palabra activa en el prompt del LLM (default: true)
REVEAL_WORD_TO_MODEL=true
